# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
JWT_PASSPHRASE='test-jwt-passphrase-not-a-real-secret'
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
# In CI this is overridden by a real env var pointing at the postgres service container;
# locally (docker compose exec php ...) it points at the same 'db' service, dbname_suffix
# from doctrine.yaml appends '_test' automatically.
DATABASE_URL="postgresql://app:app@db:5432/stockpilot?serverVersion=16&charset=utf8"
