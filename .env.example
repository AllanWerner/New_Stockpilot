# Copy this file to .env (gitignored) and fill in real values for local docker-compose runs.
# docker-compose.yml passes these through to the php/db containers.

POSTGRES_DB=stockpilot
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

APP_ENV=dev
APP_SECRET=changeme-generate-a-random-hex-string

# Passphrase protecting the JWT private key generated by
# `docker compose exec php bin/console lexik:jwt:generate-keypair`.
JWT_PASSPHRASE=changeme-generate-a-random-hex-string

# Angular dev-server / production origin allowed to call the API.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

OFF_API_BASE_URL=https://world.openfoodfacts.org

HTTP_PORT=80
ADMINER_PORT=8080
